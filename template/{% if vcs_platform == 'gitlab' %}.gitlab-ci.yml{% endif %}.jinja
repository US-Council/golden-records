# .gitlab-ci.yml — leak-guard for {{ org_name }}
#
# This pipeline scans THIS repository — {{ org_name }}'s own private
# governance repository, rendered from the golden-records commons — for
# accidentally-committed SECRETS and CREDENTIALS (API keys, private keys,
# generic tokens, passwords, cloud credentials) using gitleaks' built-in
# default ruleset.
#
# It deliberately does NOT scan for {{ org_name }}'s own organization
# identifiers (EIN, director names, address, etc.) the way the public
# golden-records commons repo's leak-guard does — those values legitimately
# belong in THIS repo. See SECURITY.md for what to do if this check ever
# fires on a real finding, and docs/CI-AND-BRANCH-PROTECTION.md for how to
# make this a required status check on protected branches.

stages:
  - leak-guard

leak-guard:
  stage: leak-guard
  image:
    name: zricethezav/gitleaks:latest
    entrypoint: [""]
  variables:
    GIT_DEPTH: 0
  script:
    - gitleaks detect --source . --config .gitleaks.toml --no-banner --redact
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH
